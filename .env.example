# Contraseña del panel. Obligatoria en Vercel; en local el respaldo es jdj2026.
# Nunca uses prefijo VITE_ (no debe ir al JavaScript del navegador).
ADMIN_PASSWORD=jdj2026

# Clave del equipo para ver el sitio mientras dura «Próximamente».
# Distinta de ADMIN_PASSWORD: no abre /jdj-cms ni permite publicar.
# Obligatoria en Vercel; en local el respaldo es equipo2026.
# También acepta TEAM_PIN como alias. Nunca uses prefijo VITE_.
TEAM_PASSWORD=equipo2026

# Publicar desde /admin en producción.
# Con un token, guardar en /admin commitea src/data/savedContent.ts y Vercel
# reconstruye el sitio solo. Sin token, /admin solo guarda en local.
# Usa un fine-grained PAT limitado a este repo con permiso Contents: read/write.
# GITHUB_TOKEN=
# Solo si el repo no es el mismo que despliega Vercel:
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=
# GITHUB_BRANCH=main

# Dominio final del sitio, para canonical, Open Graph y sitemap.
# Si se deja vacío, en Vercel se usa el dominio de producción del proyecto.
# VITE_SITE_URL=https://jdj2026.org

# Cortina de «Próximamente» (logo + cuenta regresiva). Va encendida por defecto.
# VITE_COMING_SOON=false   # apagar y mostrar el sitio público
# Fecha de apertura en hora de El Salvador. Al cumplirse, el sitio se revela solo.
# VITE_REVEAL_AT=2026-09-12T08:00

# Token de Cloudflare Web Analytics (historial de 6 meses, gratis).
# Sin token no se inyecta el script y el sitio funciona igual.
# VITE_CF_BEACON_TOKEN=

# Donaciones y tienda: Supabase (service_role; el anon no alcanza).
# SQL: supabase/schema.sql (o donations.sql + store.sql).
# Nunca uses prefijo VITE_ en secretos. El número de WhatsApp se toma de la tienda.
# URL del proyecto, SIN /rest/v1. Ejemplo: https://xxxx.supabase.co
# SUPABASE_URL=https://xxxx.supabase.co
# Clave service_role (secret). El nombre debe ser este, no SERVICE_ROLE_KEY.
# SUPABASE_SERVICE_ROLE_KEY=
