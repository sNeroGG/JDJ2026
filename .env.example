# Contraseña del panel. Obligatoria en Vercel; en local el respaldo es jdj2026.
# Nunca uses prefijo VITE_ (no debe ir al JavaScript del navegador).
ADMIN_PASSWORD=jdj2026

# Publicar desde /admin en producción.
# Con un token, guardar en /admin commitea src/data/savedContent.ts y Vercel
# reconstruye el sitio solo. Sin token, /admin solo guarda en local.
# Usa un fine-grained PAT limitado a este repo con permiso Contents: read/write.
# GITHUB_TOKEN=
# Solo si el repo no es el mismo que despliega Vercel:
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=
# GITHUB_BRANCH=main

# Dominio final del sitio, para canonical, Open Graph y sitemap.
# Si se deja vacío, en Vercel se usa el dominio de producción del proyecto.
# VITE_SITE_URL=https://jdj2026.org

# Token de Cloudflare Web Analytics (historial de 6 meses, gratis).
# Sin token no se inyecta el script y el sitio funciona igual.
# VITE_CF_BEACON_TOKEN=

# Donaciones por transferencia (WhatsApp) + Supabase.
# Nunca uses prefijo VITE_ en secretos. SQL: supabase/donations.sql
# (service_role; el anon no alcanza). El número de WhatsApp se toma de la tienda.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
